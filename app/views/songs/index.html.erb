<div class="song-list">

  <div class="search-criteria">

  <div class="row">

    <div class="<%= (can? :manage, Song) ? 'col-md-10' : 'col-md-12' %>">

      <%= render layout: 'shared/search_box', locals: { categories: [['Title', 'title'], ['Original Band', 'originalband'], ['Lyrics', 'lyrics'], ['Author', 'author']], path: '/songs/index', placeholder: 'Search songs' } do %>
      <% end %>

    </div>

    <% if can? :manage, Song %>

      <div class="col-sm-1 d-none d-md-block">
        <%= form_tag(new_song_path, :method => 'GET') do %>
          <%= submit_tag "New Song", :name => nil %>
        <%end%>
      </div>

    <% end %>

  </div>


  <div class="search-results">

    <%= turbo_frame_tag "table_frame" do %>
      <% if not @songs.nil? %>
        <% if @songs.empty? %> 
          <%= render partial: '/robyn/nothing_found' %>
        <% else %>
          <%= render partial: '/songs/song_list', locals: {songs: @songs, table_id: SongsController::TABLE_ID, show_lyrics_snippet: @show_lyrics ? params[:search_value] : nil} %>
        <% end %>

      <% else %>
      
        <% quick_queries = get_all_quick_queries(Song) %>

        <%= render partial: '/robyn/quick_queries', locals: {quick_queries: quick_queries} %>

      <% end %>
    <% end %>

  </div>

</div>