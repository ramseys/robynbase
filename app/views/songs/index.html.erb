<div class="song-list">

  <div class="search-criteria">

  <%= turbo_frame_tag "table_frame" do %>

  <div class="row">

    <div class="flex-grow-1 w-auto">

      <%= render 'shared/search_box', categories: [['Title', 'title'], ['Original Band', 'originalband'], ['Lyrics', 'lyrics'], ['Author', 'author']], path: '/songs/index', pagy: @pagy, resource_label: 'song', area: 'songs' %>

    </div>

    <% if can? :manage, Song %>

      <div class="d-none d-md-block ms-3 w-auto">
        <%= form_tag(new_song_path, :method => 'GET', data: { turbo_frame: "_top" }) do %>
          <%= submit_tag "New Song", :name => nil %>
        <%end%>
      </div>

    <% end %>

  </div>


  <div class="search-results">

      <% if not @songs.nil? %>
        <% if @songs.empty? %>
          <%= render partial: '/robyn/nothing_found' %>
        <% else %>
          <%= render partial: '/songs/song_list', locals: {songs: @songs, table_id: SongsController::TABLE_ID, show_lyrics_snippet: @show_lyrics ? params[:search_value] : nil} %>
        <% end %>

      <% else %>

        <% quick_queries = get_all_quick_queries(Song) %>

        <%= render partial: '/robyn/quick_queries', locals: {quick_queries: quick_queries} %>

      <% end %>

  </div>

  <% end %>

  </div>

</div>
