<%# locals: pagy, resource_label, area, variant (:mobile — shown only in the mobile
    list-controls bar; :desktop — shown only beside the desktop search bar; defaults to :desktop) %>
<% if pagy && pagy.count > 0 %>
  <% variant_class = { mobile: 'd-md-none', desktop: 'd-none d-md-block search-bar-result-count' }.fetch(local_assigns[:variant] || :desktop) %>
  <div class="result-count-display mb-2 <%= variant_class %>">
    <p class="text-muted mb-0">
      <% if params[:query_type] == 'quick_query' && local_assigns[:area].present? %>
        <strong class="quick-query-label"><%= QuickQuery.new(area, params[:query_id]).full_label(params[:query_attribute]) %></strong>
        <span class="mx-2">|</span>
      <% end %>
      <span class="result-count-text"><%= pluralize(pagy.count, resource_label) %></span>
    </p>
  </div>
<% end %>
