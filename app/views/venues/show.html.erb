<div class="robyn-page" data-controller="venue" data-venue-venue-value="<%= @venue.to_json %>">

<% venue_links = capture do %>
  <% if @venue.get_notes.present? %> <span><a href="#notes">Notes</a></span> <% end %>
  <% if @venue.gigs.present? %> <span><a href="#gigs">Gigs</a></span> <% end %>
<% end %>

<%= render 'shared/show_header',
           title: @venue.Name,
           inpage_links: venue_links,
           edit_path: (edit_venue_path(@venue) if can? :manage, Venue),
           edit_label: "Edit Venue",
           search_nav: @search_nav %>

<% has_map = @venue.latitude.present? %>
<% has_images = @venue.images.attached? %>

<% if has_map || has_images %>
  <div class="side-content">
    <div>

      <% if has_map && has_images %>
        <div class="venue-toggle mb-2">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-outline-secondary active"
                        data-venue-target="photosTab"
                        data-action="click->venue#showPhotos">Photos</button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-venue-target="mapTab"
                        data-action="click->venue#showMap">Map</button>
            </div>
        </div>
      <% end %>

      <% if has_map %>
        <div data-venue-target="mapContainer">
          <div id="map" class="venue-map"></div>
        </div>
      <% end %>

      <% if has_images %>
        <div data-venue-target="photosContainer">
          <%= render partial: 'robyn/image_section', locals: { object: @venue } %>
        </div>
      <% end %>

    </div>
  </div>
<% end %>

  <div>

    <h3 class="section-header">Details</h3>

    <%= build_address(@venue) %>

    <br/> <br/>

    Robyn has played this venue <%= pluralize(@venue.gigs.where(cancelled: false).length, "time") %>.

  </div>

<% if @venue.get_notes.present? %>

  <div class="content-section notes-section">

    <!-- notes-->
    <a class="anchor" name="notes"></a>
    <h3 class="section-header"> Notes </h3>

    <div>
      <%= @venue.get_notes.html_safe %>
    </div>

  </div>

<% end %>


<!-- gigs at this venue -->
<% if @venue.gigs.present? %>

  <div class="content-section gig-section">

    <a class="anchor" name="gigs"></a>
    <h3 class="section-header">Gigs</h3>

    <%= turbo_frame_tag "table_frame", src: for_resource_gigs_path(resource_type: 'venue', resource_id: @venue.id) do %>
      Loading gigs...
    <% end %>

  </div>

<% end %>

</div>
