<div class="venue-list">

  <div class="search-criteria">

  <%= turbo_frame_tag "table_frame" do %>

  <div class="row">

    <div class="flex-grow-1 w-auto">

      <%= render 'shared/search_box', categories: [['Name', 'name'], ['City', 'city'], ['State', 'state'], ['Country', 'country']], path: '/venues/index', pagy: @pagy, resource_label: 'venue', area: 'venues' %>

    </div>

    <% if can? :manage, Venue %>

      <div class="d-none d-md-block ms-3 w-auto">
        <%= form_tag(new_venue_path, :method => 'GET', data: { turbo_frame: "_top" }) do %>
          <%= submit_tag "New Venue", :name => nil %>
        <%end%>
      </div>

    <% end %>

  </div>


  <div class="search-results">

      <% if not @venues.nil? %>
        <% if @venues.empty? %>
          <%= render partial: '/robyn/nothing_found' %>
        <% else %>
          <%= render partial: '/venues/venue_list', locals: {venues: @venues, table_id: VenuesController::TABLE_ID} %>
        <% end %>

      <% else %>

        <% quick_queries = get_all_quick_queries(Venue) %>

        <%= render partial: '/robyn/quick_queries', locals: {quick_queries: quick_queries} %>

      <% end %>

  </div>

  <% end %>

  </div>

</div>
