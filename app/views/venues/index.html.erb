<div class="venue-list">

  <div class="search-criteria">

  <div class="row">

    <div class="<%= (can? :manage, Venue) ? 'col-md-10' : 'col-md-12' %>">

      <%= render layout: 'shared/search_box', locals: { categories: [['Name', 'name'], ['City', 'city'], ['State', 'state'], ['Country', 'country']], path: '/venues/index', placeholder: 'Search venues' } do %>
      <% end %>

    </div>

    <% if can? :manage, Venue %>

      <div class="col-sm-1 d-none d-md-block">
        <%= form_tag(new_venue_path, :method => 'GET') do %>
          <%= submit_tag "New Venue", :name => nil %>
        <%end%>
      </div>

    <% end %>

  </div>


  <div class="search-results">

    <%= turbo_frame_tag "table_frame" do %>
      <% if not @venues.nil? %>
        <% if @venues.empty? %> 
          <%= render partial: '/robyn/nothing_found' %>
        <% else %>
          <%= render partial: '/venues/venue_list', locals: {venues: @venues, table_id: VenuesController::TABLE_ID} %>
        <% end %>

      <% else %>
      
        <% quick_queries = get_all_quick_queries(Venue) %>

        <%= render partial: '/robyn/quick_queries', locals: {quick_queries: quick_queries} %>

      <% end %>
    <% end %>

  </div>

</div>