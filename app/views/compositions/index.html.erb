
<div class="album-list" data-controller="composition">

  <div class="search-criteria">

    <%= turbo_frame_tag "table_frame" do %>

    <div class="row">

      <div class="flex-grow-1 w-auto">

        <% expand_advanced = ( params["media_type"].present? or params["release_type"].present? ) %>

        <% advanced_options_panel = capture do %>
          <!-- advanced option block -->
          <div class="row advanced-options <%= expand_advanced ? 'expanded' : '' %>">

            <!-- release types -->
            <div class="col-sm-12">

              <div class="criteria">

                <div class="header-name">Release Type</div>

                <div class="criteria-body criteria-options">

                  <% Composition::RELEASE_TYPES.each do |name, key| %>
                    <%= check_box_tag 'release_type[]', key, Array(params['release_type']).include?(key.to_s) %>
                    <span class="radio-label"> <%= name %> </span> <br/>
                  <% end %>

                </div>

              </div>

            </div>

          </div>
        <% end %>

        <%= render 'shared/search_box', categories: [['Title', 'title'], ['Label', 'label'], ['Artist', 'artist'], ['Year', 'year']], path: '/compositions/index', pagy: @pagy, resource_label: 'release', area: 'compositions', expand_advanced: expand_advanced, advanced_options_panel: advanced_options_panel %>

      </div>

      <% if can? :manage, Composition %>

        <div class="d-none d-md-block ms-3 w-auto">
          <%= form_tag(new_composition_path, :method => 'GET', data: { turbo_frame: "_top" }) do %>
            <%= submit_tag "New Release", :name => nil %>
          <%end%>
        </div>

      <% end %>

    </div>

    <div class="search-results">

      <% if not @compositions.nil? %>
        <% if @compositions.empty? %>
          <%= render partial: '/robyn/nothing_found' %>
        <% else %>
          <%= render partial: '/compositions/release_list', locals: {albums: @compositions, table_id: CompositionsController::TABLE_ID} %>
        <% end %>

      <% else %>

        <% quick_queries = get_all_quick_queries(Composition) %>

        <%= render partial: '/robyn/quick_queries', locals: {quick_queries: quick_queries} %>

      <% end %>

    </div>

    <% end %>

  </div>

</div>
