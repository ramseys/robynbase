<% for comp in albums %>
  <tr class="clickable-row">
    <td class="main-column">
      <a href="<%= composition_path(comp) %>" class="row-link" data-turbo-frame="_top"><%= comp.Title %></a>
    </td>
    <td> <%= comp.Artist %> </td>
    <td> <%= comp.Type %> </td>
    <td> <%= comp.Year.to_i %> </td>

    <%# hand-maintained, not derived from the `columns` array in _release_list.html.erb -
        a field added there (headers + mobile sort) won't automatically show up here %>
    <% secondaryData = [comp.Artist.presence, comp.Type.presence, (comp.Year.to_i if comp.Year.to_i > 0)].compact_blank %>
    <td class="secondary-data">
      <%= safe_join(secondaryData, raw(' &middot; ')) %>
    </td>

    <% if can? :manage, Composition %>
      <td class="actions">
        <a href="<%=composition_path(comp)%>/edit" data-turbo-frame="_top">Edit</a> &nbsp;
        <%= link_to("Delete", composition_path(comp), method: :delete, data: { confirm: "Are you sure you want to delete the album #{comp.Title}?" }) %>
      </td>
    <% end %>

  </tr>
<% end %>