#!/bin/sh
# Pre-commit guard: run the full test suite (Rails + JS) and block the commit if
# anything fails. Versioned in the repo; activate once per clone with:
#   git config core.hooksPath .githooks
# (bin/setup does this for you.) Bypass in a genuine emergency with:
#   git commit --no-verify

set -e

echo "== Running Rails tests =="
bin/rails test

echo ""
echo "== Running JS tests =="
yarn test

echo ""
echo "All tests passed."
